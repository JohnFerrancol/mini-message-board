<div class="home">
  <h1 class="home-header">Messages</h1>

  <div class="card-container">
    <% messages.map(message => { %>
    <div class="card">
      <div class="card-header">
        <h2><%= message.user %></h2>
        <div class="card-date">
          <p><%= message.added %></p>
        </div>
      </div>
      <p class="card-text"><%= message.text %></p>
      <a href="/details/<%= message.id %>"
        ><button class="open-button">Open</button></a
      >
    </div>
    <% }) %>
  </div>
</div>
