<div class="new-message">
  <form class="new-message-form" method="POST" action="/new">
    <h1>Add New Message</h1>
    <div class="input-wrapper">
      <label for="messageUser">User:</label>
      <input type="text" id="messageUser" name="messageUser" required />
    </div>
    <div class="input-wrapper">
      <label for="messageText">Message:</label>
      <textarea
        type="text"
        id="messageText"
        name="messageText"
        rows="4"
        cols="50"
        required
      ></textarea>
    </div>

    <button class="submit-button" type="submit" value="Submit">
      Add Message
    </button>
  </form>
</div>
